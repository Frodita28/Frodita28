# Copia este archivo a .env.local y completa los valores. Nunca subas secretos al repositorio.

# Supabase (los muestra `npx supabase start` en local, o el panel del proyecto en producción)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo en el servidor (nunca con prefijo NEXT_PUBLIC_): permite crear cuentas y asignar contraseñas en /admin/usuarios.
# Opcional: sin ella las cuentas se crean desde el panel de Supabase (ver docs/DESPLIEGUE.md).
SUPABASE_SERVICE_ROLE_KEY=

# Contacto que aparece en la página pública (opcional; si se dejan vacíos no se muestra ninguno)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM_URL=

# Solo para las pruebas (nunca en Vercel ni en el navegador)
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
